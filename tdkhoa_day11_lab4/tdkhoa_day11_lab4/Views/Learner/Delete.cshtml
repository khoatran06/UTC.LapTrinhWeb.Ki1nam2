@model tdkhoa_day11_lab4.Models.Learner

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<div class="container mt-4">

    ```
    <h1>Xóa sinh viên</h1>

    <h4 class="text-danger">
        Bạn có chắc chắn muốn xóa sinh viên này không?
    </h4>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Mã sinh viên
        </dt>
        <dd class="col-sm-9">
            @Model.LearnerID
        </dd>

        <dt class="col-sm-3">
            Tên sinh viên
        </dt>
        <dd class="col-sm-9">
            @Model.FirstMidName
        </dd>

        <dt class="col-sm-3">
            Họ sinh viên
        </dt>
        <dd class="col-sm-9">
            @Model.LastName
        </dd>

        <dt class="col-sm-3">
            Ngày nhập học
        </dt>
        <dd class="col-sm-9">
            @Model.EnrollmentDate.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-3">
            Chuyên ngành
        </dt>
        <dd class="col-sm-9">
            @(Model.Major?.MajorName ?? "Chưa xác định")
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="LearnerID" />

        <button type="submit" class="btn btn-danger">
            Xác nhận xóa
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Hủy
        </a>

    </form>
    ```

</div>
