@model tdkhoa_day11_lab4.Models.Learner

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<div class="container mt-4">

    ```
    <h1>Chi tiết sinh viên</h1>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">Mã sinh viên</dt>
        <dd class="col-sm-9">@Model.LearnerID</dd>

        <dt class="col-sm-3">Họ và tên</dt>
        <dd class="col-sm-9">@Model.LastName @Model.FirstMidName</dd>

        <dt class="col-sm-3">Ngày nhập học</dt>
        <dd class="col-sm-9">@Model.EnrollmentDate.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Chuyên ngành</dt>
        <dd class="col-sm-9">@(Model.Major?.MajorName ?? "Chưa xác định")</dd>
    </dl>

    <h4 class="mt-4">Các môn học đã đăng ký</h4>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Mã môn học</th>
                <th>Tên môn học</th>
                <th>Số tín chỉ</th>
                <th>Điểm</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Enrollments != null && Model.Enrollments.Any())
            {
                foreach (var enrollment in Model.Enrollments)
                {
                    <tr>
                        <td>@enrollment.CourseID</td>
                        <td>@(enrollment.Course?.Title ?? "Chưa xác định")</td>
                        <td>@(enrollment.Course?.Credits)</td>
                        <td>@enrollment.Grade</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        Sinh viên chưa đăng ký môn học.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Edit"
       asp-route-id="@Model.LearnerID"
       class="btn btn-warning">
        Sửa thông tin
    </a>

    <a asp-action="Index" class="btn btn-secondary">
        Quay lại danh sách
    </a>
    ```

</div>
