@model tdkhoa_day11_lab4.Models.Learner

@{
    ViewData["Title"] = "Sửa thông tin sinh viên";
}

<div class="container mt-4">

    ```
    <h1>Sửa thông tin sinh viên</h1>

    <hr />

    <div class="row">
        <div class="col-md-6">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <input type="hidden" asp-for="LearnerID" />

                <div class="form-group mb-3">
                    <label asp-for="FirstMidName" class="control-label">
                        Tên sinh viên
                    </label>

                    <input asp-for="FirstMidName" class="form-control" />

                    <span asp-validation-for="FirstMidName"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="LastName" class="control-label">
                        Họ sinh viên
                    </label>

                    <input asp-for="LastName" class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EnrollmentDate" class="control-label">
                        Ngày nhập học
                    </label>

                    <input asp-for="EnrollmentDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="EnrollmentDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="MajorID" class="control-label">
                        Chuyên ngành
                    </label>

                    <select asp-for="MajorID"
                            asp-items="ViewBag.MajorID"
                            class="form-select">
                        <option value="">-- Chọn chuyên ngành --</option>
                    </select>

                    <span asp-validation-for="MajorID"
                          class="text-danger">
                    </span>
                </div>

                <div class="form-group mt-3">

                    <button type="submit" class="btn btn-primary">
                        Lưu thay đổi
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </form>

        </div>
    </div>
    ```

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
