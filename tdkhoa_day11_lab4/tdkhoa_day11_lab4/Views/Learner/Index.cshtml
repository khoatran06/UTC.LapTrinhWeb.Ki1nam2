@model IEnumerable<tdkhoa_day11_lab4.Models.Learner>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container mt-4">

    <h1>Danh sách sinh viên</h1>

    <hr />

    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên</th>
                <th>Họ</th>
                <th>Chuyên ngành</th>
                <th>Ngày nhập học</th>
                <th>Chức năng</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var learner in Model)
                {
                    <tr>
                        <td>@learner.LearnerID</td>

                        <td>@learner.FirstMidName</td>

                        <td>@learner.LastName</td>

                        <td>@learner.Major?.MajorName</td>

                        <td>
                            @learner.EnrollmentDate.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@learner.LearnerID"
                               class="btn btn-info btn-sm">
                                Chi tiết
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@learner.LearnerID"
                               class="btn btn-warning btn-sm">
                               
                                Sửa
                            </a>

                            |

                            <a asp-action="Delete"
                               asp-route-id="@learner.LearnerID"
                               class="btn btn-danger btn-sm">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center">
                        Chưa có dữ liệu sinh viên.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Create" class="btn btn-primary">
        Thêm sinh viên mới
    </a>

</div>