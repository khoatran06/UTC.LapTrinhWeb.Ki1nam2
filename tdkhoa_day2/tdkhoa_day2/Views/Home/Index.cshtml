            <p>Product Name 1</p>

        </div>


        <!-- Product 2 -->
        <div class="product-card">

            <img src="~/images/product2.jpg"
                 alt="Product Name 2" />

            <p>Product Name 2</p>

        </div>


        <!-- Product 3 -->
        <div class="product-card">

            <img src="~/images/product3.jpg"
                 alt="Product Name 3" />

            <p>Product Name 3</p>

        </div>


        <!-- Product 4 -->
        <div class="product-card">

            <img src="~/images/product4.jpg"
                 alt="Product Name 4" />

            <p>Product Name 4</p>

        </div>

    </div>

</div>