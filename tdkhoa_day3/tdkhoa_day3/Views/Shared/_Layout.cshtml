<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - tdkhoa_day3</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/tdkhoa_day3.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    MyAppMVC
                </a>

                <!-- Menu -->
                <div class="navbar-collapse collapse">

                    <ul class="navbar-nav">

                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link text-light"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <!-- About -->
                        <li class="nav-item">
                            <a class="nav-link text-light"
                               href="#">
                                About
                            </a>
                        </li>

                        <!-- Contact -->
                        <li class="nav-item">
                            <a class="nav-link text-light"
                               href="#">
                                Contact
                            </a>
                        </li>

                        <!-- Demo Index -->
                        <li class="nav-item">
                            <a class="nav-link text-light"
                               href="#">
                                Demo Index
                            </a>
                        </li>

                        <!-- Account -->
                        <li class="nav-item">
                            <a class="nav-link text-light"
                               href="#">
                                Account
                            </a>
                        </li>

                        <!-- Sản phẩm -->
                        <li class="nav-item">
                            <a class="nav-link text-light"
                               asp-controller="Product"
                               asp-action="Index">
                                Sản phẩm
                            </a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - tdkhoa_day3 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
