@model List<tdkhoa_day7.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";

    var categories =
        ViewBag.Categories as List<tdkhoa_day7.Models.Category>;
}

<h1>Danh sách sản phẩm</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<a asp-action="Create"
   class="btn btn-primary mb-3">
    Thêm sản phẩm
</a>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>ID</th>
            <th>Ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Danh mục</th>
            <th>Giá</th>
            <th>Giá khuyến mãi</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            var category =
                categories?.FirstOrDefault(
                    x => x.Id == item.CategoryId);

            <tr>

                <td>
                    @item.Id
                </td>

                <td>
                    <img src="~/products/@item.Image"
                         width="100"
                         height="100"
                         style="object-fit:cover;" />
                </td>

                <td>
                    @item.Name
                </td>

                <td>
                    @category?.Name
                </td>

                <td>
                    @item.Price.ToString("N0") VNĐ
                </td>

                <td>
                    @item.SalePrice.ToString("N0") VNĐ
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Xem
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <form asp-action="Delete"
                          asp-route-id="@item.Id"
                          method="post"
                          style="display:inline"
                          onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');">

                        <button type="submit"
                                class="btn btn-danger btn-sm">
                            Xóa
                        </button>

                    </form>

                </td>

            </tr>
        }

    </tbody>

</table>